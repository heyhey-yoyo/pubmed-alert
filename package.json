{
  "name": "pubmed-keyword-alert-worker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "npx --yes wrangler@4.117.0 dev --test-scheduled",
    "deploy": "npx --yes wrangler@4.117.0 deploy",
    "typecheck": "npx --yes --package typescript@5.8.3 tsc --noEmit -p tsconfig.json",
    "build:test": "npx --yes --package typescript@5.8.3 tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test"
  }
}
